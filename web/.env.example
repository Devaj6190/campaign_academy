# Copy to .env.local and fill in. Never commit .env.local.
# Server-only: read by the staff agent routes, never sent to the browser.
ANTHROPIC_API_KEY=
# The morning paper (lib/paper/model.ts). A Gemini API key from Google AI Studio (it starts with "AIza"). Without it,
# Claude writes the paper. GEMINI_MODEL is optional; the default is gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=
# Texts to the student's phone (lib/photon, Photon Spectrum iMessage). From your project's Settings at app.photon.codes.
# Without them the app runs as before and the Desk menu says texting is not set up.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The project's iMessage line, shown to the student to text first (Photon free lines are inbound-first). Not a secret.
SPECTRUM_IMESSAGE_LINE=
# LangSmith tracing (optional). Set LANGSMITH_TRACING=true and a key, and every LangChain run (the staff, the rivals,
# memos, remarks, planks and the debrief) is recorded as a trace; nothing about what the agents do changes. The
# Gemini-written paper is not a LangChain call and is not traced. Without these, nothing is traced.
# The key is a Personal Access Token from smith.langchain.com, Settings, API Keys (it starts with "lsv2_pt_").
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=campaign-academy
# Only for a LangSmith workspace in the EU region; leave it commented out otherwise:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
