# Copy to .env.local and fill in. Never commit .env.local.
# Server-only: read by the staff agent routes, never sent to the browser.
ANTHROPIC_API_KEY=
# The morning paper (lib/paper/model.ts). A Gemini API key from Google AI Studio (it starts with "AIza"). Without it,
# Claude writes the paper. GEMINI_MODEL is optional; the default is gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=
# Texts to the student's phone (lib/photon, Photon Spectrum iMessage). From your project's Settings at app.photon.codes.
# Without them the app runs as before and the Desk menu says texting is not set up.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The project's iMessage line, shown to the student to text first (Photon free lines are inbound-first). Not a secret.
SPECTRUM_IMESSAGE_LINE=
